{
  "id": "hylogger",
  "version": 1,
  "engine_api": 1,
  "source": {
    "reader": "hylogger.reader",
    "data_suffix": "-scalars.csv",
    "manifest_suffix": "-source.json",
    "licence": null,
    "attribution": null
  },
  "capabilities": {
    "intake": {
      "impl": "hylogger.intake.reader",
      "reads_raw_source": true,
      "stage": "source_intake"
    },
    "profile_source": {
      "impl": "hylogger.analysis.statistics",
      "reads_raw_source": true,
      "stage": "profile"
    },
    "plan": {
      "impl": "hylogger.generation.plan",
      "calls_model": "planner",
      "stage": "plan"
    },
    "generate": {
      "impl": "hylogger.generation.generate",
      "stage": "generate"
    },
    "validate": {
      "impl": "hylogger.validation.checks",
      "writes_verdict": true,
      "stage": "validate"
    },
    "repair": {
      "impl": "hylogger.generation.repair",
      "calls_model": "planner",
      "stage": "repair"
    },
    "image_intake": {
      "impl": "hylogger.imaging.intake",
      "stage": "image_intake",
      "reads_raw_source": true
    },
    "image_synthesize": {
      "impl": "hylogger.imaging.generate",
      "stage": "image_synthesize"
    },
    "image_validate": {
      "impl": "hylogger.imaging.checks",
      "writes_verdict": true,
      "stage": "image_validate"
    },
    "image_critique": {
      "impl": "hylogger.imaging.critic",
      "calls_model": "critic",
      "advisory": true,
      "critic_policy": "optional",
      "stage": "image_critique"
    },
    "local_critique": {
      "impl": "hylogger.validation.critique",
      "calls_model": "local_critic",
      "advisory": true,
      "critic_policy": "required",
      "stage": "local_critique"
    },
    "package_artifact": {
      "impl": "hylogger.capabilities",
      "stage": "artifact"
    },
    "package_release": {
      "impl": "hylogger.capabilities",
      "stage": "release"
    }
  },
  "graph": [
    {
      "step": "intake"
    },
    {
      "step": "profile_source"
    },
    {
      "step": "plan"
    },
    {
      "loop": [
        "generate",
        "validate"
      ],
      "on_fail": "repair",
      "max_attempts": "max_attempts",
      "stage": "generate_validate_repair"
    },
    {
      "step": "image_intake"
    },
    {
      "step": "image_synthesize"
    },
    {
      "step": "image_validate"
    },
    {
      "step": "image_critique"
    },
    {
      "step": "local_critique"
    },
    {
      "step": "package_artifact"
    },
    {
      "gate": "human_review"
    },
    {
      "step": "package_release"
    }
  ],
  "checks": [
    {
      "id": "has_rows",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true
    },
    {
      "id": "backward_steps",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true
    },
    {
      "id": "depth_non_decreasing",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true
    },
    {
      "id": "depth_finite",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true
    },
    {
      "id": "depth_nonnegative",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true,
      "note": "StartDepth metres are never negative (minimum 0.0001 m across the 43 measured holes); R02."
    },
    {
      "id": "spacing_median",
      "kind": "fidelity",
      "threshold": {
        "source": "real_vs_real_band"
      },
      "required": true
    },
    {
      "id": "repeated_depth_fraction",
      "kind": "fidelity",
      "threshold": {
        "source": "real_vs_real_band"
      },
      "required": true
    },
    {
      "id": "valid_fraction",
      "kind": "fidelity",
      "threshold": {
        "source": "real_vs_real_band"
      },
      "required": true
    },
    {
      "id": "repeated_depths_masked_out",
      "kind": "fidelity",
      "threshold": {
        "source": "real_vs_real_band"
      },
      "required": true
    },
    {
      "id": "invalid_label_rate",
      "kind": "fidelity",
      "threshold": {
        "source": "split_half_reference"
      },
      "required": true,
      "note": "The artifact must not label invalid rows more often than its source hole does; R01."
    },
    {
      "id": "swir_answer_rate",
      "kind": "fidelity",
      "threshold": {
        "source": "real_vs_real_band"
      },
      "required": false,
      "note": "Calibrated band is vacuous (RP-05 owns informative bands); a skip is shown in the report but never gates acceptance. Re-require when the band is informative."
    },
    {
      "id": "tir_answer_rate",
      "kind": "fidelity",
      "threshold": {
        "source": "real_vs_real_band"
      },
      "required": true
    },
    {
      "id": "swir_answer_fidelity",
      "kind": "fidelity",
      "threshold": {
        "source": "split_half_reference"
      },
      "required": true,
      "note": "The SWIR band is vacuous, so severe answer loss is judged against the source hole's own rate (tolerance: source split-half delta, cross-hole p95, plus a 2/sqrt(n) finite-sample allowance); R01."
    },
    {
      "id": "tir_answer_fidelity",
      "kind": "fidelity",
      "threshold": {
        "source": "split_half_reference"
      },
      "required": true
    },
    {
      "id": "swir_vocabulary",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true
    },
    {
      "id": "tir_vocabulary",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true
    },
    {
      "id": "swir_source_vocabulary",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true,
      "note": "The artifact must not answer labels its source hole never answers; R01."
    },
    {
      "id": "tir_source_vocabulary",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true
    },
    {
      "id": "swir_label_richness",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true,
      "note": "Collapse to a single label while the source answers two or more fails; R01."
    },
    {
      "id": "tir_label_richness",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true
    },
    {
      "id": "swir_fidelity",
      "kind": "fidelity",
      "threshold": {
        "source": "split_half_reference"
      },
      "required": true
    },
    {
      "id": "tir_fidelity",
      "kind": "fidelity",
      "threshold": {
        "source": "split_half_reference"
      },
      "required": true
    },
    {
      "id": "row_count_match",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true,
      "note": "The artifact carries exactly the plan's requested row count; R02."
    },
    {
      "id": "depth_start_match",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true,
      "note": "The artifact starts at the profile's fitted start depth; R02."
    },
    {
      "id": "depth_end_within_requested",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true,
      "note": "The artifact end stays within the requested start-plus-step-times-rows extent; R02."
    },
    {
      "id": "csv_schema",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true
    },
    {
      "id": "image_histogram_distance",
      "kind": "fidelity",
      "threshold": {
        "source": "literal",
        "max": 0.35
      },
      "required": true,
      "applicable_when": "images_present"
    },
    {
      "id": "image_dimensions",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true,
      "applicable_when": "images_present"
    },
    {
      "id": "image_strip_alignment",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      },
      "required": true,
      "applicable_when": "images_present"
    }
  ],
  "release": {
    "members": [
      {"name": "data.csv", "required": true},
      {"name": "plan.json", "required": true},
      {"name": "validation-report.json", "required": true},
      {"name": "seed.txt", "required": true},
      {"name": "provenance.md", "required": true},
      {"name": "run.jsonl", "required": true, "source": "engine-log"},
      {"name": "synthetic.png", "required": true, "when": "images_present"},
      {"name": "image-statistics.json", "required": true, "when": "images_present"},
      {"name": "image-validation.json", "required": true, "when": "images_present"}
    ]
  },
  "models": {
    "roles": {
      "planner": {
        "provider": "meta-api",
        "model": "muse-spark-1.3",
        "adapter": "meta_cli",
        "reasoning_effort": "max",
        "structured_output": true
      },
      "critic": {
        "provider": "meta-api",
        "model": "muse-spark-1.3",
        "adapter": "meta_cli",
        "reasoning_effort": "max",
        "structured_output": true
      },
      "local_critic": {
        "provider": "local",
        "model": "muse-glimmer-30B",
        "adapter": "glimmer_local",
        "structured_output": true,
        "requires": {
          "open_weight": true
        }
      },
      "reporter": {
        "provider": "meta-api",
        "model": "muse-wonder-1.0",
        "adapter": "meta_cli",
        "reasoning_effort": "max",
        "structured_output": true,
        "enabled": false
      }
    },
    "budget": {
      "max_tokens_per_run": 500000
    }
  },
  "limits": {
    "max_rows": 200000
  }
}
