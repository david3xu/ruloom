{
  "id": "tabular",
  "version": 1,
  "engine_api": 1,
  "source": {
    "reader": "tabular.reader",
    "data_suffix": "-tabular.csv",
    "manifest_suffix": "-source.json",
    "licence": null,
    "attribution": null
  },
  "capabilities": {
    "intake": {
      "impl": "tabular.intake.reader",
      "reads_raw_source": true,
      "stage": "source_intake"
    },
    "profile_source": {
      "impl": "tabular.analysis.statistics",
      "reads_raw_source": true,
      "stage": "profile"
    },
    "plan": {
      "impl": "tabular.generation.plan",
      "calls_model": "planner",
      "stage": "plan"
    },
    "generate": {
      "impl": "tabular.generation.generate",
      "stage": "generate"
    },
    "validate": {
      "impl": "tabular.validation.checks",
      "writes_verdict": true,
      "stage": "validate"
    },
    "repair": {
      "impl": "tabular.generation.plan",
      "calls_model": "planner",
      "stage": "repair"
    },
    "describe": {
      "impl": "tabular.analysis.statistics",
      "advisory": true,
      "stage": "describe"
    },
    "package_artifact": {
      "impl": "tabular.capabilities",
      "stage": "artifact"
    },
    "package_release": {
      "impl": "tabular.capabilities",
      "stage": "release"
    }
  },
  "graph": [
    {
      "step": "intake"
    },
    {
      "step": "profile_source"
    },
    {
      "step": "plan"
    },
    {
      "loop": [
        "generate",
        "validate"
      ],
      "on_fail": "repair",
      "max_attempts": "max_attempts",
      "stage": "generate_validate_repair"
    },
    {
      "step": "describe"
    },
    {
      "step": "package_artifact"
    },
    {
      "gate": "human_review"
    },
    {
      "step": "package_release"
    }
  ],
  "checks": [
    {
      "id": "has_rows",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      }
    },
    {
      "id": "schema_columns",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      }
    },
    {
      "id": "row_count",
      "kind": "constraint",
      "threshold": {
        "source": "literal"
      }
    },
    {
      "id": "mean_value",
      "kind": "fidelity",
      "threshold": {
        "source": "relative_tolerance"
      }
    }
  ],
  "models": {
    "roles": {
      "planner": {
        "provider": "meta-api",
        "model": "muse-spark-1.3",
        "adapter": "meta_cli",
        "reasoning_effort": "max",
        "structured_output": true
      }
    },
    "budget": {
      "max_tokens_per_run": 250000
    }
  },
  "limits": {
    "max_rows": 200000
  }
}
